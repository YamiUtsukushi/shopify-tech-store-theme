{% comment %}
  Customer Reviews — Compatible Dawn (Shopify)
  Fichier : sections/customer-reviews.liquid
{% endcomment %}

{{ 'customer-reviews.css' | asset_url | stylesheet_tag }}

<section class="cr-section" id="cr-{{ section.id }}" style="background: {{ section.settings.section_bg }};">

  {%- comment %} Header {% endcomment -%}
  {%- if section.settings.title != blank -%}
    <div class="cr__header" style="background: {{ section.settings.header_bg }};">
      <h2 class="cr__title" style="color: {{ section.settings.title_color }}; font-size: {{ section.settings.title_size }}px;">
        {{ section.settings.title }}
      </h2>
    </div>
  {%- endif -%}

  {%- comment %} Slider {% endcomment -%}
  <div class="cr__slider-wrapper">
    <button class="cr__nav cr__nav--prev" id="crPrev-{{ section.id }}" aria-label="Précédent" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    <div class="cr__slider" id="crSlider-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign rating = block.settings.rating -%}

          <div class="cr__card" style="border-color: {{ section.settings.card_border_color }};" {{ block.shopify_attributes }}>

            {%- comment %} Étoiles {% endcomment -%}
            <div class="cr__stars-row">
              <div class="cr__stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rating -%}
                    <svg class="cr__star cr__star--full" viewBox="0 0 24 24" fill="#FFC107" width="18" height="18">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {%- else -%}
                    <svg class="cr__star cr__star--empty" viewBox="0 0 24 24" fill="none" stroke="#FFC107" stroke-width="1.5" width="18" height="18">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <span class="cr__rating-text">{{ rating }} | {{ block.settings.review_count }} Avis</span>
            </div>

            {%- comment %} Texte de l'avis {% endcomment -%}
            {%- if block.settings.review_text != blank -%}
              <p class="cr__review-text">"{{ block.settings.review_text }}"</p>
            {%- endif -%}

            {%- comment %} Auteur {% endcomment -%}
            <div class="cr__author">
              {%- if block.settings.author_photo != blank -%}
                <img
                  src="{{ block.settings.author_photo | image_url: width: 100 }}"
                  alt="{{ block.settings.author_name | escape }}"
                  class="cr__author-photo"
                  width="56"
                  height="56"
                  loading="lazy"
                >
              {%- else -%}
                <div class="cr__author-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                  </svg>
                </div>
              {%- endif -%}
              <div class="cr__author-info">
                <p class="cr__author-name">{{ block.settings.author_name }}</p>
                {%- if block.settings.author_role != blank -%}
                  <p class="cr__author-role">{{ block.settings.author_role }}</p>
                {%- endif -%}
              </div>
            </div>

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <button class="cr__nav cr__nav--next" id="crNext-{{ section.id }}" aria-label="Suivant" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  </div>

</section>

<script>
(function() {
  var slider  = document.getElementById('crSlider-{{ section.id }}');
  var prevBtn = document.getElementById('crPrev-{{ section.id }}');
  var nextBtn = document.getElementById('crNext-{{ section.id }}');
  if (!slider) return;

  function cardWidth() {
    var card = slider.querySelector('.cr__card');
    if (!card) return 280;
    return card.offsetWidth + parseInt(getComputedStyle(slider).gap || 20);
  }

  function updateNav() {
    var overflows = slider.scrollWidth > slider.clientWidth + 2;
    var atStart   = slider.scrollLeft <= 0;
    var atEnd     = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 2;
    if (prevBtn) prevBtn.style.visibility = (!overflows || atStart) ? 'hidden' : 'visible';
    if (nextBtn) nextBtn.style.visibility = (!overflows || atEnd)   ? 'hidden' : 'visible';
  }

  if (prevBtn) prevBtn.addEventListener('click', function() {
    slider.scrollBy({ left: -cardWidth(), behavior: 'smooth' });
  });
  if (nextBtn) nextBtn.addEventListener('click', function() {
    slider.scrollBy({ left: cardWidth(), behavior: 'smooth' });
  });

  slider.addEventListener('scroll', updateNav, { passive: true });
  window.addEventListener('resize', updateNav);
  setTimeout(updateNav, 100);
})();
</script>

