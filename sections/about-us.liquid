{% comment %}
  À Propos — iDhightech2 — Compatible Dawn (Shopify)
  Fichier : sections/about-us.liquid
{% endcomment %}

{{ 'about-us.css' | asset_url | stylesheet_tag }}

<div class="about" id="about-{{ section.id }}">

  {%- comment %} ========== HERO ========== {% endcomment -%}
  <div class="about__hero">
    {%- if section.settings.hero_image != blank -%}
      <div class="about__hero-img-wrap">
        <img
          src="{{ section.settings.hero_image | image_url: width: 1920 }}"
          alt="{{ section.settings.hero_title }}"
          class="about__hero-img"
          loading="eager"
          width="1920"
          height="600"
        >
        <div class="about__hero-overlay"></div>
      </div>
    {%- else -%}
      <div class="about__hero-gradient"></div>
    {%- endif -%}
    <div class="about__hero-content">
      <p class="about__hero-eyebrow">{{ section.settings.hero_eyebrow }}</p>
      <h1 class="about__hero-title">{{ section.settings.hero_title }}</h1>
      <p class="about__hero-subtitle">{{ section.settings.hero_subtitle }}</p>
    </div>
  </div>

  {%- comment %} ========== HISTOIRE ========== {% endcomment -%}
  <div class="about__story">
    <div class="about__story-inner">
      <div class="about__story-text">
        <span class="about__section-eyebrow">{{ section.settings.story_eyebrow }}</span>
        <h2 class="about__section-title">{{ section.settings.story_title }}</h2>
        <div class="about__story-body">{{ section.settings.story_text }}</div>
      </div>
      <div class="about__story-visual">
        {%- if section.settings.story_image != blank -%}
          <img
            src="{{ section.settings.story_image | image_url: width: 600 }}"
            alt="Notre histoire"
            class="about__story-img"
            loading="lazy"
            width="600"
            height="500"
          >
        {%- else -%}
          <div class="about__story-placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="80" height="80" opacity="0.2">
              <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment %} ========== CHIFFRES CLÉS ========== {% endcomment -%}
  {%- if section.settings.show_stats -%}
    <div class="about__stats">
      <div class="about__stats-inner">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="about__stat" {{ block.shopify_attributes }}>
              <span class="about__stat-value">{{ block.settings.value }}</span>
              <span class="about__stat-label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment %} ========== VALEURS ========== {% endcomment -%}
  <div class="about__values">
    <div class="about__values-inner">
      <div class="about__section-header">
        <span class="about__section-eyebrow">{{ section.settings.values_eyebrow }}</span>
        <h2 class="about__section-title">{{ section.settings.values_title }}</h2>
      </div>
      <div class="about__values-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="about__value-card" {{ block.shopify_attributes }}>
              <div class="about__value-icon">{{ block.settings.icon }}</div>
              <h3 class="about__value-title">{{ block.settings.title }}</h3>
              <p class="about__value-text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment %} ========== ÉQUIPE ========== {% endcomment -%}
  {%- if section.settings.show_team -%}
    <div class="about__team">
      <div class="about__team-inner">
        <div class="about__section-header">
          <span class="about__section-eyebrow">{{ section.settings.team_eyebrow }}</span>
          <h2 class="about__section-title">{{ section.settings.team_title }}</h2>
          <p class="about__team-subtitle">{{ section.settings.team_subtitle }}</p>
        </div>
        <div class="about__team-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'team_member' -%}
              <div class="about__member" {{ block.shopify_attributes }}>
                <div class="about__member-photo-wrap">
                  {%- if block.settings.photo != blank -%}
                    <img
                      src="{{ block.settings.photo | image_url: width: 300 }}"
                      alt="{{ block.settings.name }}"
                      class="about__member-photo"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  {%- else -%}
                    <div class="about__member-placeholder">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                      </svg>
                    </div>
                  {%- endif -%}
                </div>
                <h3 class="about__member-name">{{ block.settings.name }}</h3>
                <p class="about__member-role">{{ block.settings.role }}</p>
                {%- if block.settings.bio != blank -%}
                  <p class="about__member-bio">{{ block.settings.bio }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment %} ========== POURQUOI NOUS ========== {% endcomment -%}
  <div class="about__why">
    <div class="about__why-inner">
      <div class="about__section-header">
        <span class="about__section-eyebrow">{{ section.settings.why_eyebrow }}</span>
        <h2 class="about__section-title">{{ section.settings.why_title }}</h2>
      </div>
      <div class="about__why-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'why_item' -%}
            <div class="about__why-item" {{ block.shopify_attributes }}>
              <div class="about__why-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <div>
                <h3 class="about__why-title">{{ block.settings.title }}</h3>
                <p class="about__why-text">{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment %} ========== CTA FINAL ========== {% endcomment -%}
  <div class="about__cta">
    <div class="about__cta-inner">
      <h2 class="about__cta-title">{{ section.settings.cta_title }}</h2>
      <p class="about__cta-text">{{ section.settings.cta_text }}</p>
      <div class="about__cta-btns">
        {%- if section.settings.cta_btn1_label != blank -%}
          <a href="{{ section.settings.cta_btn1_url }}" class="about__cta-btn about__cta-btn--primary">{{ section.settings.cta_btn1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_btn2_label != blank -%}
          <a href="{{ section.settings.cta_btn2_url }}" class="about__cta-btn about__cta-btn--secondary">{{ section.settings.cta_btn2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

</div>

