      "default": "Suivi de commande"
    },
    {
      "type": "url",
      "id": "link_tracking_url",
      "label": "Suivi de commande — URL"
    },
    {
      "type": "text",
      "id": "link_returns_label",
      "label": "Retours — Texte",
      "default": "Retours & remboursements"
    },
    {
      "type": "url",
