{% comment %}
  Custom Footer — Compatible Dawn (Shopify)
  Fichier : sections/custom-footer.liquid
{% endcomment %}

{{ 'custom-footer.css' | asset_url | stylesheet_tag }}

<footer class="custom-footer" id="custom-footer-{{ section.id }}">

  {%- comment %} ========== COLONNES PRINCIPALES ========== {% endcomment -%}
  <div class="custom-footer__main">
    <div class="custom-footer__inner">

      {%- comment %} COLONNE 1 — À propos {% endcomment -%}
      <div class="custom-footer__col">
        <div class="custom-footer__brand">
          {%- if section.settings.footer_logo != blank -%}
            <a href="/" class="custom-footer__logo-link">
              <img
                src="{{ section.settings.footer_logo | image_url: width: 180 }}"
                alt="{{ shop.name }}"
                class="custom-footer__logo"
                width="{{ section.settings.footer_logo_width }}"
                loading="lazy"
              >
            </a>
          {%- else -%}
            <a href="/" class="custom-footer__shop-name">{{ shop.name }}</a>
          {%- endif -%}

          {%- if section.settings.about_text != blank -%}
            <p class="custom-footer__about">{{ section.settings.about_text }}</p>
          {%- endif -%}

          {%- comment %} Réseaux sociaux {% endcomment -%}
          <div class="custom-footer__socials">
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" class="custom-footer__social" target="_blank" rel="noopener" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" class="custom-footer__social" target="_blank" rel="noopener" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <a href="{{ section.settings.social_youtube }}" class="custom-footer__social" target="_blank" rel="noopener" aria-label="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a href="{{ section.settings.social_tiktok }}" class="custom-footer__social" target="_blank" rel="noopener" aria-label="TikTok">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_twitter != blank -%}
              <a href="{{ section.settings.social_twitter }}" class="custom-footer__social" target="_blank" rel="noopener" aria-label="X (Twitter)">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment %} COLONNE 2 — Service client {% endcomment -%}
      <div class="custom-footer__col">
        <h3 class="custom-footer__col-title">{{ section.settings.col2_title }}</h3>
        <ul class="custom-footer__links">
          {%- if section.settings.link_faq_label != blank -%}
            <li><a href="{{ section.settings.link_faq_url }}" class="custom-footer__link">{{ section.settings.link_faq_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.link_tracking_label != blank -%}
            <li><a href="{{ section.settings.link_tracking_url }}" class="custom-footer__link">{{ section.settings.link_tracking_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.link_returns_label != blank -%}
            <li><a href="{{ section.settings.link_returns_url }}" class="custom-footer__link">{{ section.settings.link_returns_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.link_shipping_label != blank -%}
            <li><a href="{{ section.settings.link_shipping_url }}" class="custom-footer__link">{{ section.settings.link_shipping_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.link_contact_label != blank -%}
            <li><a href="{{ section.settings.link_contact_url }}" class="custom-footer__link">{{ section.settings.link_contact_label }}</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment %} COLONNE 3 — Mon compte {% endcomment -%}
      <div class="custom-footer__col">
        <h3 class="custom-footer__col-title">{{ section.settings.col4_title }}</h3>
        <ul class="custom-footer__links">
          {%- if customer -%}
            <li><a href="{{ routes.account_url }}" class="custom-footer__link">Mon compte</a></li>
            <li><a href="{{ routes.account_url }}/orders" class="custom-footer__link">Mes commandes</a></li>
          {%- else -%}
            <li><a href="{{ routes.account_login_url }}" class="custom-footer__link">Se connecter</a></li>
            <li><a href="{{ routes.account_register_url }}" class="custom-footer__link">Créer un compte</a></li>
          {%- endif -%}
          {%- if section.settings.link_wishlist_label != blank -%}
            <li><a href="{{ section.settings.link_wishlist_url }}" class="custom-footer__link">{{ section.settings.link_wishlist_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.link_about_label != blank -%}
            <li><a href="{{ section.settings.link_about_url }}" class="custom-footer__link">{{ section.settings.link_about_label }}</a></li>
          {%- endif -%}
        </ul>
      </div>

    </div>
  </div>

  {%- comment %} ========== BARRE DU BAS ========== {% endcomment -%}
  <div class="custom-footer__bottom">
    <div class="custom-footer__bottom-inner">

      {%- comment %} Copyright {% endcomment -%}
      <p class="custom-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}
      </p>

      {%- comment %} Moyens de paiement {% endcomment -%}
      <div class="custom-footer__payments">
        {%- if section.settings.show_visa -%}
          <div class="custom-footer__payment-badge" aria-label="Visa">
            <svg viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" width="36" height="22">
              <rect width="60" height="40" rx="5" fill="#fff"/>
              <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-size="14" font-weight="900" font-family="Arial" fill="#1A1F71">VISA</text>
            </svg>
          </div>
        {%- endif -%}
        {%- if section.settings.show_mastercard -%}
          <div class="custom-footer__payment-badge" aria-label="Mastercard">
            <svg viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" width="36" height="22">
              <rect width="60" height="40" rx="5" fill="#fff"/>
              <circle cx="23" cy="20" r="11" fill="#EB001B"/>
              <circle cx="37" cy="20" r="11" fill="#F79E1B"/>
              <path d="M30 11.5a11 11 0 0 1 0 17 11 11 0 0 1 0-17z" fill="#FF5F00"/>
            </svg>
          </div>
        {%- endif -%}
        {%- if section.settings.show_paypal -%}
          <div class="custom-footer__payment-badge" aria-label="PayPal">
            <svg viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" width="36" height="22">
              <rect width="60" height="40" rx="5" fill="#fff"/>
              <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-size="9" font-weight="800" font-family="Arial" fill="#003087">Pay</text>
              <text x="50%" y="72%" dominant-baseline="middle" text-anchor="middle" font-size="9" font-weight="800" font-family="Arial" fill="#009CDE">Pal</text>
            </svg>
          </div>
        {%- endif -%}
        {%- if section.settings.show_applepay -%}
          <div class="custom-footer__payment-badge" aria-label="Apple Pay">
            <svg viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" width="36" height="22">
              <rect width="60" height="40" rx="5" fill="#fff"/>
              <text x="50%" y="58%" dominant-baseline="middle" text-anchor="middle" font-size="8" font-weight="600" font-family="Arial" fill="#000"> Pay</text>
              <text x="29%" y="56%" dominant-baseline="middle" text-anchor="middle" font-size="13" font-family="Arial" fill="#000"></text>
            </svg>
          </div>
        {%- endif -%}
        {%- if section.settings.show_googlepay -%}
          <div class="custom-footer__payment-badge" aria-label="Google Pay">
            <svg viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" width="36" height="22">
              <rect width="60" height="40" rx="5" fill="#fff"/>
              <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-size="7.5" font-weight="600" font-family="Arial">
                <tspan fill="#4285F4">G</tspan><tspan fill="#EA4335">o</tspan><tspan fill="#FBBC05">o</tspan><tspan fill="#4285F4">g</tspan><tspan fill="#34A853">l</tspan><tspan fill="#EA4335">e </tspan><tspan fill="#000"> Pay</tspan>
              </text>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment %} Liens légaux {% endcomment -%}
      <div class="custom-footer__legal-links">
        {%- if shop.privacy_policy.url -%}
          <a href="{{ shop.privacy_policy.url }}" class="custom-footer__legal-link">Confidentialité</a>
        {%- endif -%}
        {%- if shop.refund_policy.url -%}
          <a href="{{ shop.refund_policy.url }}" class="custom-footer__legal-link">Retours</a>
        {%- endif -%}
        {%- if shop.shipping_policy.url -%}
          <a href="{{ shop.shipping_policy.url }}" class="custom-footer__legal-link">Expédition</a>
        {%- endif -%}
        {%- if shop.terms_of_service.url -%}
          <a href="{{ shop.terms_of_service.url }}" class="custom-footer__legal-link">CGS</a>
        {%- endif -%}
        {%- if shop.terms_of_sale.url -%}
          <a href="{{ shop.terms_of_sale.url }}" class="custom-footer__legal-link">CGV</a>
        {%- endif -%}
        {%- if shop.legal_notice.url -%}
          <a href="{{ shop.legal_notice.url }}" class="custom-footer__legal-link">Mentions légales</a>
        {%- endif -%}
      </div>

      {%- comment %} Sélecteur de langue {% endcomment -%}
      {%- if localization.available_languages.size > 1 -%}
        <div class="custom-footer__lang">
          <button class="custom-footer__lang-btn" id="footerLangBtn-{{ section.id }}" type="button" aria-expanded="false">
            {{ localization.language.endonym_name }}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="custom-footer__lang-dropdown" id="footerLangDropdown-{{ section.id }}" hidden>
            {%- form 'localization' -%}
              {%- for language in localization.available_languages -%}
                <button
                  type="submit"
                  name="locale_code"
                  value="{{ language.iso_code }}"
                  class="custom-footer__lang-option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                >
                  {{ language.endonym_name }}
                </button>
              {%- endfor -%}
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>

</footer>

<script>
(function() {
  var langBtn      = document.getElementById('footerLangBtn-{{ section.id }}');
  var langDropdown = document.getElementById('footerLangDropdown-{{ section.id }}');
  if (langBtn && langDropdown) {
    langBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !langDropdown.hidden;
      langDropdown.hidden = isOpen;
      langBtn.setAttribute('aria-expanded', String(!isOpen));
      langBtn.classList.toggle('is-open', !isOpen);
    });
    document.addEventListener('click', function() {
      langDropdown.hidden = true;
      langBtn.setAttribute('aria-expanded', 'false');
      langBtn.classList.remove('is-open');
    });
  }
})();
</script>

{% schema %}
{
  "name": "Pied de page",
  "tag": "footer",
  "class": "custom-footer-wrapper",
  "limit": 1,
  "settings": [
