    {
      "type": "text",
      "id": "link_shipping_label",
      "label": "Livraison — Texte",
      "default": "Livraison & délais"
    },
    {
      "type": "url",
      "id": "link_shipping_url",
      "label": "Livraison — URL"
    },
    {
      "type": "text",
      "id": "link_contact_label",
      "label": "Contact — Texte",
      "default": "Contactez-nous"
    },
    {
      "type": "url",
      "id": "link_contact_url",
      "label": "Contact — URL"
    },
    {
      "type": "header",
      "content": "Colonne 3 — Mon compte"
    },
    {
      "type": "text",
      "id": "col4_title",
      "label": "Titre colonne 3",
      "default": "Mon Compte"
    },
    {
      "type": "text",
      "id": "link_wishlist_label",
      "label": "Liste de souhaits — Texte",
      "default": "Ma liste de souhaits"
    },
    {
      "type": "url",
      "id": "link_wishlist_url",
      "label": "Liste de souhaits — URL"
    },
    {
      "type": "text",
      "id": "link_about_label",
      "label": "À propos — Texte",
      "default": "À propos de nous"
