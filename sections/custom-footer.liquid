{% comment %}
  Custom Footer — Compatible Dawn (Shopify) — REFONTE COMPLÈTE
  Fichier : sections/custom-footer.liquid
  MODIF : colonnes dynamiques via blocks link_list, icônes sociales colorées,
          paiement déplacé sous les socials, barre du bas copyright + liens légaux
{% endcomment %}

{{ 'custom-footer.css' | asset_url | stylesheet_tag }}

<footer class="custom-footer" id="custom-footer-{{ section.id }}">

  {%- comment %} ========== CORPS PRINCIPAL ========== {% endcomment -%}
  <div class="custom-footer__main">
    <div class="custom-footer__inner">

      {%- comment %} COLONNE 1 — Marque, réseaux sociaux, paiement {% endcomment -%}
      <div class="custom-footer__col custom-footer__col--brand">

        {%- comment %} Logo ou nom de la boutique {% endcomment -%}
        {%- if section.settings.footer_logo != blank -%}
          <a href="/" class="custom-footer__logo-link">
            <img
              src="{{ section.settings.footer_logo | image_url: width: 360 }}"
              alt="{{ shop.name }}"
              class="custom-footer__logo"
              width="{{ section.settings.footer_logo.width | at_most: 360 }}"
              height="{{ section.settings.footer_logo.height | at_most: 160 }}"
              loading="lazy"
            >
          </a>
        {%- else -%}
          <a href="/" class="custom-footer__shop-name">{{ shop.name }}</a>
        {%- endif -%}

        {%- if section.settings.about_text != blank -%}
          <p class="custom-footer__about">{{ section.settings.about_text }}</p>
        {%- endif -%}

        {%- comment %} Réseaux sociaux — vraies couleurs de marque {% endcomment -%}
        <div class="custom-footer__socials">
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="custom-footer__social custom-footer__social--facebook" target="_blank" rel="noopener" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="custom-footer__social custom-footer__social--instagram" target="_blank" rel="noopener" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" class="custom-footer__social custom-footer__social--youtube" target="_blank" rel="noopener" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" class="custom-footer__social custom-footer__social--tiktok" target="_blank" rel="noopener" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_twitter != blank -%}
            <a href="{{ section.settings.social_twitter }}" class="custom-footer__social custom-footer__social--twitter" target="_blank" rel="noopener" aria-label="X (Twitter)">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>

        {%- comment %} Icônes de paiement — en dessous des réseaux sociaux {% endcomment -%}
        <div class="custom-footer__payments">
          {%- if section.settings.show_visa -%}
            <div class="custom-footer__payment-badge" aria-label="Visa" title="Visa">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#fff"/>
                <text x="30" y="25" text-anchor="middle" font-size="16" font-weight="900" font-family="Arial,sans-serif" fill="#1A1F71" letter-spacing="1">VISA</text>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_mastercard -%}
            <div class="custom-footer__payment-badge" aria-label="Mastercard" title="Mastercard">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#fff"/>
                <circle cx="22" cy="19" r="12" fill="#EB001B"/>
                <circle cx="38" cy="19" r="12" fill="#F79E1B"/>
                <path d="M30 9.2a12 12 0 0 1 0 19.6A12 12 0 0 1 30 9.2z" fill="#FF5F00"/>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_paypal -%}
            <div class="custom-footer__payment-badge" aria-label="PayPal" title="PayPal">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#fff"/>
                <text x="30" y="16" text-anchor="middle" font-size="11" font-weight="800" font-family="Arial,sans-serif" fill="#003087">Pay</text>
                <text x="30" y="29" text-anchor="middle" font-size="11" font-weight="800" font-family="Arial,sans-serif" fill="#009CDE">Pal</text>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_applepay -%}
            <div class="custom-footer__payment-badge" aria-label="Apple Pay" title="Apple Pay">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#000"/>
                <text x="34" y="23" text-anchor="middle" font-size="11" font-weight="500" font-family="-apple-system,Helvetica,Arial,sans-serif" fill="#fff">Pay</text>
                <text x="17" y="23" text-anchor="middle" font-size="16" font-family="-apple-system,Helvetica,Arial,sans-serif" fill="#fff"></text>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_shoppay -%}
            <div class="custom-footer__payment-badge" aria-label="Shop Pay" title="Shop Pay">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#5C6AC4"/>
                <text x="30" y="23" text-anchor="middle" font-size="9" font-weight="700" font-family="Arial,sans-serif" fill="#fff">Shop Pay</text>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_klarna -%}
            <div class="custom-footer__payment-badge" aria-label="Klarna" title="Klarna">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#FFB3C7"/>
                <text x="30" y="24" text-anchor="middle" font-size="12" font-weight="700" font-family="Arial,sans-serif" fill="#000">klarna</text>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_amex -%}
            <div class="custom-footer__payment-badge" aria-label="American Express" title="American Express">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#007BC1"/>
                <text x="30" y="24" text-anchor="middle" font-size="10" font-weight="700" font-family="Arial,sans-serif" fill="#fff">AMEX</text>
              </svg>
            </div>
          {%- endif -%}
          {%- if section.settings.show_cb -%}
            <div class="custom-footer__payment-badge" aria-label="Carte Bancaire" title="Carte Bancaire">
              <svg viewBox="0 0 60 38" xmlns="http://www.w3.org/2000/svg" width="48" height="30">
                <rect width="60" height="38" rx="5" fill="#004E9A"/>
                <text x="30" y="25" text-anchor="middle" font-size="17" font-weight="900" font-family="Arial,sans-serif" fill="#fff">CB</text>
              </svg>
            </div>
          {%- endif -%}
        </div>

      </div>

      {%- comment %} COLONNES DYNAMIQUES — configurables depuis le customizer {% endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' -%}
          {%- assign nav = linklists[block.settings.menu_handle] -%}
          <div class="custom-footer__col" {{ block.shopify_attributes }}>
            <h3 class="custom-footer__col-title">{{ block.settings.column_title }}</h3>
            {%- if nav.links.size > 0 -%}
              <ul class="custom-footer__links">
                {%- for link in nav.links -%}
                  <li>
                    <a href="{{ link.url }}" class="custom-footer__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>

  {%- comment %} ========== BARRE DU BAS ========== {% endcomment -%}
  <div class="custom-footer__bottom">
    <div class="custom-footer__bottom-inner">

      {%- comment %} Copyright — gauche {% endcomment -%}
      <p class="custom-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}
      </p>

      {%- comment %} Liens légaux — droite {% endcomment -%}
      <div class="custom-footer__legal-links">
        {%- if shop.privacy_policy.url -%}
          <a href="{{ shop.privacy_policy.url }}" class="custom-footer__legal-link">Confidentialité</a>
        {%- endif -%}
        {%- if shop.refund_policy.url -%}
          <a href="{{ shop.refund_policy.url }}" class="custom-footer__legal-link">Retours</a>
        {%- endif -%}
        {%- if shop.shipping_policy.url -%}
          <a href="{{ shop.shipping_policy.url }}" class="custom-footer__legal-link">Expédition</a>
        {%- endif -%}
        {%- if shop.terms_of_service.url -%}
          <a href="{{ shop.terms_of_service.url }}" class="custom-footer__legal-link">CGS</a>
        {%- endif -%}
        {%- if shop.terms_of_sale.url -%}
          <a href="{{ shop.terms_of_sale.url }}" class="custom-footer__legal-link">CGV</a>
        {%- endif -%}
        {%- if shop.legal_notice.url -%}
          <a href="{{ shop.legal_notice.url }}" class="custom-footer__legal-link">Mentions légales</a>
        {%- endif -%}
      </div>

      {%- comment %} Sélecteur de langue (si plusieurs langues actives) {% endcomment -%}
      {%- if localization.available_languages.size > 1 -%}
        <div class="custom-footer__lang">
          <button class="custom-footer__lang-btn" id="footerLangBtn-{{ section.id }}" type="button" aria-expanded="false">
            {{ localization.language.endonym_name }}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="custom-footer__lang-dropdown" id="footerLangDropdown-{{ section.id }}" hidden>
            {%- form 'localization' -%}
              {%- for language in localization.available_languages -%}
                <button
                  type="submit"
                  name="locale_code"
                  value="{{ language.iso_code }}"
                  class="custom-footer__lang-option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                >
                  {{ language.endonym_name }}
                </button>
              {%- endfor -%}
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>

</footer>

<script>
(function() {
  var langBtn      = document.getElementById('footerLangBtn-{{ section.id }}');
  var langDropdown = document.getElementById('footerLangDropdown-{{ section.id }}');
  if (langBtn && langDropdown) {
    langBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !langDropdown.hidden;
      langDropdown.hidden = isOpen;
      langBtn.setAttribute('aria-expanded', String(!isOpen));
      langBtn.classList.toggle('is-open', !isOpen);
    });
    document.addEventListener('click', function() {
      langDropdown.hidden = true;
      langBtn.setAttribute('aria-expanded', 'false');
      langBtn.classList.remove('is-open');
    });
  }
})();
</script>

{% schema %}
{
  "name": "Pied de page",
  "tag": "footer",
  "class": "custom-footer-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Colonne marque — Logo & description"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo du footer"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Description courte",
      "default": "Votre boutique électronique de confiance. Retrouvez les meilleures marques au meilleur prix."
    },
    {
      "type": "header",
      "content": "Réseaux sociaux"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X (Twitter)"
    },
    {
      "type": "header",
      "content": "Moyens de paiement"
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Afficher Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Afficher Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paypal",
      "label": "Afficher PayPal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_applepay",
      "label": "Afficher Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shoppay",
      "label": "Afficher Shop Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_klarna",
      "label": "Afficher Klarna",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "Afficher American Express",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cb",
      "label": "Afficher Carte Bancaire (CB)",
      "default": true
    },
    {
      "type": "header",
      "content": "Barre du bas"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Texte copyright",
      "default": "Tous droits réservés."
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Colonne de menu",
      "settings": [
        {
          "type": "text",
          "id": "column_title",
          "label": "Titre de la colonne",
          "default": "Navigation"
        },
        {
          "type": "link_list",
          "id": "menu_handle",
          "label": "Menu à afficher",
          "default": "footer",
          "info": "Créez vos menus dans Boutique en ligne > Navigation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [
        {
          "type": "menu_column",
          "settings": {
            "column_title": "Service Client",
            "menu_handle": "footer"
          }
        },
        {
          "type": "menu_column",
          "settings": {
            "column_title": "Mon Compte",
            "menu_handle": "footer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
