    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X (Twitter)"
    },
    {
      "type": "header",
      "content": "Colonne 2 — Service client"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Titre colonne 2",
