{% comment %}
  Announcement Bar — Compatible Dawn (Shopify)
  Fichier : sections/announcement-bar.liquid
{% endcomment %}

{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}

<div class="announcement-bar" id="announcement-bar-{{ section.id }}">

  {%- comment %} GAUCHE — Réseaux sociaux {% endcomment -%}
  <div class="announcement-bar__left">
    {%- if section.settings.facebook_url != blank -%}
      <a href="{{ section.settings.facebook_url }}" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.instagram_url != blank -%}
      <a href="{{ section.settings.instagram_url }}" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.youtube_url != blank -%}
      <a href="{{ section.settings.youtube_url }}" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="YouTube">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
          <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
          <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#000" opacity="0" style="fill:var(--announcement-play,#000)"/>
          <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.tiktok_url != blank -%}
      <a href="{{ section.settings.tiktok_url }}" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="TikTok">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.twitter_url != blank -%}
      <a href="{{ section.settings.twitter_url }}" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="X (Twitter)">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    {%- endif -%}
  </div>

  {%- comment %} CENTRE — Messages défilants {% endcomment -%}
  <div class="announcement-bar__center">
    <div class="announcement-bar__slider" id="announcementSlider-{{ section.id }}">
      {%- if section.settings.message_1 != blank -%}
        <div class="announcement-bar__slide">{{ section.settings.message_1 }}</div>
      {%- endif -%}
      {%- if section.settings.message_2 != blank -%}
        <div class="announcement-bar__slide">{{ section.settings.message_2 }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment %} DROITE — Sélecteur de langue {% endcomment -%}
  <div class="announcement-bar__right">
    {%- if localization.available_languages.size > 1 -%}
      <div class="announcement-bar__lang">
        <button class="announcement-bar__lang-btn" id="langBtn-{{ section.id }}" aria-expanded="false" aria-haspopup="listbox">
          {{ localization.language.endonym_name }}
          <svg class="announcement-bar__lang-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="announcement-bar__lang-dropdown" id="langDropdown-{{ section.id }}" role="listbox" hidden>
          {%- form 'localization', class: 'announcement-bar__lang-form' -%}
            {%- for language in localization.available_languages -%}
              <button
                type="submit"
                name="locale_code"
                value="{{ language.iso_code }}"
                class="announcement-bar__lang-option{% if language.iso_code == localization.language.iso_code %} announcement-bar__lang-option--active{% endif %}"
                role="option"
                {% if language.iso_code == localization.language.iso_code %}aria-selected="true"{% endif %}
              >
                {{ language.endonym_name }}
              </button>
            {%- endfor -%}
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}
  </div>

</div>

<script>
(function() {
  // ---- Slider messages centre ----
  var slider = document.getElementById('announcementSlider-{{ section.id }}');
  if (slider) {
    var slides = slider.querySelectorAll('.announcement-bar__slide');
    if (slides.length > 1) {
      var current = 0;
      slides[0].classList.add('is-active');

      setInterval(function() {
        slides[current].classList.remove('is-active');
        slides[current].classList.add('is-exit');

        setTimeout(function() {
          slides[current].classList.remove('is-exit');
          current = (current + 1) % slides.length;
          slides[current].classList.add('is-active');
        }, 500);

      }, {{ section.settings.slide_interval | times: 1000 }});
    } else if (slides.length === 1) {
      slides[0].classList.add('is-active');
    }
  }

  // ---- Sélecteur de langue ----
  var langBtn = document.getElementById('langBtn-{{ section.id }}');
  var langDropdown = document.getElementById('langDropdown-{{ section.id }}');
  if (langBtn && langDropdown) {
    langBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !langDropdown.hidden;
      langDropdown.hidden = isOpen;
      langBtn.setAttribute('aria-expanded', String(!isOpen));
      langBtn.classList.toggle('is-open', !isOpen);
    });
    document.addEventListener('click', function() {
      langDropdown.hidden = true;
      langBtn.setAttribute('aria-expanded', 'false');
      langBtn.classList.remove('is-open');
    });
  }
})();
</script>

{% schema %}
{
  "name": "Barre d'annonces",
  "tag": "div",
  "class": "announcement-bar-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Réseaux sociaux"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Lien Facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Lien Instagram"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "Lien YouTube"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "Lien TikTok"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Lien X (Twitter)"
    },
    {
      "type": "header",
      "content": "Messages défilants"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Bienvenue sur notre boutique !"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "Profitez de -40% sur toute la boutique 🎉"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Durée d'affichage de chaque message",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonces"
    }
  ]
}
{% endschema %}
