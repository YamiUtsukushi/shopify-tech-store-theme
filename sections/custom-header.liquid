{% comment %}
  Custom Header — Compatible Dawn (Shopify)
  Fichier : sections/custom-header.liquid
{% endcomment %}

{{ 'custom-header.css' | asset_url | stylesheet_tag }}

{%- assign featured_product = section.settings.featured_product -%}
{%- assign featured_end_date = section.settings.featured_end_date -%}

<div class="custom-header" id="custom-header-{{ section.id }}">

  {%- comment %} ========== LIGNE 1 ========== {% endcomment -%}
  <div class="custom-header__top" style="background:{{ section.settings.top_bg }};color:{{ section.settings.top_text_color }};">
    <div class="custom-header__top-inner">

      {%- comment %} Hamburger mobile — visible ≤ 768px {% endcomment -%}
      <button class="custom-header__hamburger" id="mobileMenuBtn-{{ section.id }}" aria-label="Ouvrir le menu" type="button" style="color:{{ section.settings.top_text_color }};">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      {%- comment %} Logo {% endcomment -%}
      <div class="custom-header__logo">
        <a href="/" aria-label="Accueil">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_height = section.settings.logo.height | times: section.settings.logo_width | divided_by: section.settings.logo.width -%}
            <img
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name }}"
              class="custom-header__logo-img"
              width="{{ section.settings.logo_width }}"
              height="{{ logo_height }}"
              loading="eager"
            >
          {%- else -%}
            <span class="custom-header__logo-text" style="color:{{ section.settings.top_text_color }};">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      {%- comment %} Recherche avec suggestions prédictives {% endcomment -%}
      {%- comment %} MODIF : ajout recherche prédictive custom via /search/suggest.json {% endcomment -%}
      <div class="custom-header__search" id="customSearchWrap-{{ section.id }}">
        <form action="/search" method="get" class="custom-header__search-form" role="search" autocomplete="off">
          <input
            type="search"
            name="q"
            id="customSearchInput-{{ section.id }}"
            placeholder="Rechercher des produits..."
            class="custom-header__search-input"
            aria-label="Rechercher"
            aria-autocomplete="list"
            aria-controls="customSearchSuggestions-{{ section.id }}"
            aria-expanded="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="custom-header__search-btn" aria-label="Lancer la recherche">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </form>
        <div
          class="custom-search-suggestions"
          id="customSearchSuggestions-{{ section.id }}"
          role="listbox"
          aria-label="Suggestions de recherche"
          hidden
        ></div>
      </div>

      {%- comment %} Droite : compte + panier {% endcomment -%}
      <div class="custom-header__actions">

        {%- comment %} Compte client {% endcomment -%}
        <a href="{{ routes.account_url }}" class="custom-header__action-link" style="color:{{ section.settings.top_text_color }};" aria-label="Mon compte">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <div class="custom-header__action-text">
            {%- if customer -%}
              <span class="custom-header__action-label">Bonjour, {{ customer.first_name }}</span>
              <span class="custom-header__action-sub">Mon compte</span>
            {%- else -%}
              <span class="custom-header__action-label">Bonjour, connectez-vous</span>
              <span class="custom-header__action-sub">Compte & Listes</span>
            {%- endif -%}
          </div>
        </a>

        {%- comment %} Mini panier {% endcomment -%}
        <button
          class="custom-header__action-link custom-header__cart-btn"
          style="color:{{ section.settings.top_text_color }};"
          id="cartDrawerOpen-{{ section.id }}"
          aria-label="Ouvrir le panier"
          type="button"
        >
          <div class="custom-header__cart-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="custom-header__cart-count" id="cartCount-{{ section.id }}">{{ cart.item_count }}</span>
          </div>
          <div class="custom-header__action-text">
            <span class="custom-header__action-label">Panier</span>
            <span class="custom-header__action-sub" id="cartTotal-{{ section.id }}">{{ cart.total_price | money }}</span>
          </div>
        </button>

      </div>
    </div>
  </div>

  {%- comment %} ========== LIGNE 2 — Navigation ========== {% endcomment -%}
  <div class="custom-header__nav" style="background:{{ section.settings.nav_bg }};color:{{ section.settings.nav_text_color }};">
    <div class="custom-header__nav-inner">

      {%- comment %} Toutes les catégories {% endcomment -%}
      <div class="custom-header__categories" id="categoriesWrap-{{ section.id }}">
        <button class="custom-header__categories-btn" id="categoriesBtn-{{ section.id }}" style="color:{{ section.settings.nav_text_color }};" type="button" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          Menu
        </button>
        <div class="custom-header__categories-dropdown" id="categoriesDropdown-{{ section.id }}" hidden>
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection_link' -%}
              {%- assign col = block.settings.collection -%}
              {%- if col != blank -%}
                <a href="{{ col.url }}" class="custom-header__categories-item" {{ block.shopify_attributes }}>
                  {%- if col.image -%}
                    <img src="{{ col.image | image_url: width: 40 }}" alt="{{ col.title }}" width="40" height="40" class="custom-header__categories-img">
                  {%- endif -%}
                  {{ col.title }}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment %} Menu de navigation principal {% endcomment -%}
      <nav class="custom-header__menu" aria-label="Navigation principale">
        {%- if section.settings.menu != blank -%}
          {%- assign nav_menu = section.settings.menu -%}
          {%- for link in linklists[nav_menu].links -%}
            {%- if link.links.size > 0 -%}
              <div class="custom-header__menu-item custom-header__menu-item--parent">
                <button class="custom-header__menu-link custom-header__menu-link--parent" style="color:{{ section.settings.nav_text_color }};" type="button">
                  {{ link.title }}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                <div class="custom-header__submenu">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="custom-header__submenu-link">{{ child.title }}</a>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <div class="custom-header__menu-item">
                <a href="{{ link.url }}" class="custom-header__menu-link" style="color:{{ section.settings.nav_text_color }};">{{ link.title }}</a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>

      {%- comment %} Liens secondaires droite {% endcomment -%}
      <div class="custom-header__secondary-links">
        {%- if section.settings.secondary_link_1_label != blank -%}
          <a href="{{ section.settings.secondary_link_1_url }}" class="custom-header__secondary-link" style="color:{{ section.settings.nav_text_color }};">
            ⚡ {{ section.settings.secondary_link_1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_link_2_label != blank -%}
          <span class="custom-header__secondary-sep" style="color:{{ section.settings.nav_text_color }};">|</span>
          <a href="{{ section.settings.secondary_link_2_url }}" class="custom-header__secondary-link" style="color:{{ section.settings.nav_text_color }};">{{ section.settings.secondary_link_2_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_link_3_label != blank -%}
          <span class="custom-header__secondary-sep" style="color:{{ section.settings.nav_text_color }};">|</span>
          <a href="{{ section.settings.secondary_link_3_url }}" class="custom-header__secondary-link" style="color:{{ section.settings.nav_text_color }};">{{ section.settings.secondary_link_3_label }}</a>
        {%- endif -%}
      </div>

    </div>
  </div>

</div>

{%- comment %} ========== MENU MOBILE (drawer gauche) ========== {% endcomment -%}
<div class="mobile-drawer" id="mobileDrawer-{{ section.id }}" aria-hidden="true">
  <div class="mobile-drawer__overlay" id="mobileDrawerOverlay-{{ section.id }}"></div>
  <nav class="mobile-drawer__panel" style="background:{{ section.settings.top_bg }};color:{{ section.settings.top_text_color }};">

    <div class="mobile-drawer__header">
      <span class="mobile-drawer__title" style="color:{{ section.settings.top_text_color }};">Menu</span>
      <button class="mobile-drawer__close" id="mobileDrawerClose-{{ section.id }}" aria-label="Fermer le menu" type="button" style="color:{{ section.settings.top_text_color }};">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="mobile-drawer__body">

      {%- comment %} Navigation principale {% endcomment -%}
      {%- if section.settings.menu != blank -%}
        {%- assign nav_menu = section.settings.menu -%}
        {%- for link in linklists[nav_menu].links -%}
          {%- if link.links.size > 0 -%}
            <div class="mobile-drawer__group">
              <button class="mobile-drawer__group-btn" type="button">
                {{ link.title }}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="mobile-drawer__group-body">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" class="mobile-drawer__sub-link">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment %} Catégories {% endcomment -%}
      {%- assign has_cats = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_link' and block.settings.collection != blank -%}
          {%- assign has_cats = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_cats -%}
        <div class="mobile-drawer__section-title">Catégories</div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_link' -%}
            {%- assign col = block.settings.collection -%}
            {%- if col != blank -%}
              <a href="{{ col.url }}" class="mobile-drawer__link mobile-drawer__link--cat">
                {%- if col.image -%}
                  <img src="{{ col.image | image_url: width: 40 }}" alt="{{ col.title }}" width="32" height="32" class="mobile-drawer__cat-img">
                {%- endif -%}
                {{ col.title }}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment %} Liens secondaires {% endcomment -%}
      {%- if section.settings.secondary_link_1_label != blank or section.settings.secondary_link_2_label != blank or section.settings.secondary_link_3_label != blank -%}
        <div class="mobile-drawer__section-title">Liens utiles</div>
        {%- if section.settings.secondary_link_1_label != blank -%}
          <a href="{{ section.settings.secondary_link_1_url }}" class="mobile-drawer__link">⚡ {{ section.settings.secondary_link_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_link_2_label != blank -%}
          <a href="{{ section.settings.secondary_link_2_url }}" class="mobile-drawer__link">{{ section.settings.secondary_link_2_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_link_3_label != blank -%}
          <a href="{{ section.settings.secondary_link_3_url }}" class="mobile-drawer__link">{{ section.settings.secondary_link_3_label }}</a>
        {%- endif -%}
      {%- endif -%}

      {%- comment %} Compte {% endcomment -%}
      <div class="mobile-drawer__section-title">Mon compte</div>
      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="mobile-drawer__link">👤 Bonjour, {{ customer.first_name }}</a>
        <a href="{{ routes.account_logout_url }}" class="mobile-drawer__link">Déconnexion</a>
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="mobile-drawer__link">Connexion</a>
        <a href="{{ routes.account_register_url }}" class="mobile-drawer__link">Créer un compte</a>
      {%- endif -%}

    </div>
  </nav>
</div>

{%- comment %} ========== TIROIR PANIER ========== {% endcomment -%}
<div class="cart-drawer" id="cartDrawer-{{ section.id }}" aria-hidden="true" role="dialog" aria-label="Votre panier">
  <div class="cart-drawer__overlay" id="cartOverlay-{{ section.id }}"></div>

  <div class="cart-drawer__panel">

    {%- comment %} Header du drawer {% endcomment -%}
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Mon Panier <span class="cart-drawer__count" id="drawerCount-{{ section.id }}">({{ cart.item_count }})</span></h2>
      <button class="cart-drawer__close" id="cartDrawerClose-{{ section.id }}" aria-label="Fermer le panier" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    {%- comment %} Corps du drawer {% endcomment -%}
    <div class="cart-drawer__body" id="cartDrawerBody-{{ section.id }}">
      {%- if cart.item_count == 0 -%}

        {%- comment %} ---- PANIER VIDE ---- {% endcomment -%}
        <div class="cart-empty">
          <svg class="cart-empty__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="60" height="60">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <p class="cart-empty__title">Votre panier est vide</p>
          <a href="/collections/all" class="cart-empty__continue">Continuer les achats</a>

          {%- if featured_product != blank -%}
            <div class="cart-empty__featured">
              <p class="cart-empty__featured-label">Offre du moment</p>
              {%- if featured_product.featured_image != blank -%}
                <img
                  src="{{ featured_product.featured_image | image_url: width: 240 }}"
                  alt="{{ featured_product.title | escape }}"
                  class="cart-empty__featured-img"
                  width="120"
                  height="120"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if featured_end_date != blank -%}
                <div class="cart-empty__countdown flash-sale__countdown" data-end="{{ featured_end_date }}">
                  <div class="flash-sale__countdown-item">
                    <span class="flash-sale__countdown-value" data-days>00</span>
                    <span class="flash-sale__countdown-label">Jours</span>
                  </div>
                  <div class="flash-sale__countdown-item">
                    <span class="flash-sale__countdown-value" data-hours>00</span>
                    <span class="flash-sale__countdown-label">Hrs</span>
                  </div>
                  <div class="flash-sale__countdown-item">
                    <span class="flash-sale__countdown-value" data-mins>00</span>
                    <span class="flash-sale__countdown-label">Min</span>
                  </div>
                  <div class="flash-sale__countdown-item">
                    <span class="flash-sale__countdown-value" data-secs>00</span>
                    <span class="flash-sale__countdown-label">Sec</span>
                  </div>
                </div>
              {%- endif -%}
              <p class="cart-empty__featured-title">{{ featured_product.title }}</p>
              <p class="cart-empty__featured-price">{{ featured_product.price | money }}</p>
              <button
                class="cart-empty__add-btn"
                data-variant-id="{{ featured_product.selected_or_first_available_variant.id }}"
                onclick="window.customHeaderAddToCart(this)"
                type="button"
              >
                Ajouter au panier
              </button>
            </div>
          {%- endif -%}
        </div>

      {%- else -%}

        {%- comment %} ---- ARTICLES ---- {% endcomment -%}
        <div class="cart-items">
          {%- for item in cart.items -%}
            <div class="cart-item" data-key="{{ item.key }}">
              {%- if item.image -%}
                <img
                  src="{{ item.image | image_url: width: 140 }}"
                  alt="{{ item.title | escape }}"
                  class="cart-item__img"
                  width="70"
                  height="70"
                  loading="lazy"
                >
              {%- endif -%}
              <div class="cart-item__info">
                <p class="cart-item__title">{{ item.product.title }}</p>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>
                <div class="cart-item__qty">
                  <button class="cart-item__qty-btn" data-action="decrease" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" type="button">−</button>
                  <span class="cart-item__qty-val">{{ item.quantity }}</span>
                  <button class="cart-item__qty-btn" data-action="increase" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" type="button">+</button>
                </div>
              </div>
              <button class="cart-item__remove" data-key="{{ item.key }}" aria-label="Supprimer" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                  <path d="M10 11v6M14 11v6"/>
                  <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                </svg>
              </button>
            </div>
          {%- endfor -%}
        </div>

      {%- endif -%}
    </div>

    {%- comment %} Footer du drawer (caché si vide) {% endcomment -%}
    <div class="cart-drawer__footer" id="cartDrawerFooter-{{ section.id }}" {% if cart.item_count == 0 %}hidden{% endif %}>
      {%- unless customer -%}
        <div class="cart-drawer__login-nudge">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
          <span>Vous possédez un compte ? <a href="{{ routes.account_login_url }}" class="cart-drawer__login-link">Connectez-vous</a> pour payer plus vite.</span>
        </div>
      {%- endunless -%}
      <div class="cart-drawer__subtotal">
        <span>Sous-total</span>
        <span id="drawerTotal-{{ section.id }}">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__taxes-note">Taxes et frais de livraison calculés à la validation</p>
      <a href="/checkout" class="cart-drawer__checkout-btn">Passer la commande</a>
      <a href="/cart" class="cart-drawer__view-cart">Voir le panier complet</a>
    </div>

  </div>
</div>

<style>
  .custom-header__search-btn { background: {{ section.settings.search_btn_color }}; }
  .custom-header__categories-btn:hover,
  .custom-header__menu-link:hover { color: {{ section.settings.nav_hover_color }} !important; }

  /* MODIF : Dropdown suggestions prédictives */
  #customSearchWrap-{{ section.id }} {
    position: relative;
  }
  .custom-search-suggestions {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 9999;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    overflow: hidden;
    max-height: 480px;
    overflow-y: auto;
  }
  .custom-search-suggestions__group {
    padding: 10px 0;
  }
  .custom-search-suggestions__group + .custom-search-suggestions__group {
    border-top: 1px solid rgba(0,0,0,0.07);
  }
  .custom-search-suggestions__title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
    padding: 0 14px 6px;
    margin: 0;
  }
  .custom-search-suggestions__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Ligne suggestion texte (query) */
  .custom-search-suggestions__query {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    cursor: pointer;
    color: rgba(0,0,0,0.75);
    font-size: 13px;
    transition: background 0.15s;
  }
  .custom-search-suggestions__query svg {
    flex-shrink: 0;
    opacity: 0.4;
  }
  .custom-search-suggestions__query:hover,
  .custom-search-suggestions__query.is-selected {
    background: rgba(0,0,0,0.04);
    color: #000;
  }
  .custom-search-suggestions__query em {
    font-style: normal;
    color: {{ section.settings.search_btn_color }};
    font-weight: 600;
  }
  /* Ligne produit */
  .custom-search-suggestions__product {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .custom-search-suggestions__product:hover,
  .custom-search-suggestions__product.is-selected {
    background: rgba(0,0,0,0.04);
  }
  .custom-search-suggestions__product-img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
    background: rgba(0,0,0,0.05);
  }
  .custom-search-suggestions__product-img--placeholder {
    display: block;
  }
  .custom-search-suggestions__product-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .custom-search-suggestions__product-title {
    font-size: 13px;
    font-weight: 500;
    color: rgba(0,0,0,0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .custom-search-suggestions__product-price {
    font-size: 12px;
    font-weight: 700;
    color: {{ section.settings.search_btn_color }};
  }
  /* Lien "Voir tous les résultats" */
  .custom-search-suggestions__see-all {
    display: block;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: {{ section.settings.search_btn_color }};
    padding: 10px 14px;
    border-top: 1px solid rgba(0,0,0,0.07);
    text-decoration: none;
    transition: background 0.15s;
  }
  .custom-search-suggestions__see-all:hover {
    background: rgba(0,0,0,0.03);
  }
</style>

<script>
(function() {
  var sectionId = '{{ section.id }}';

  // ---- Helpers ----
  function qs(id) { return document.getElementById(id); }

  // ---- Drawer open/close ----
  var drawer     = qs('cartDrawer-' + sectionId);
  var overlay    = qs('cartOverlay-' + sectionId);
  var openBtn    = qs('cartDrawerOpen-' + sectionId);
  var closeBtn   = qs('cartDrawerClose-' + sectionId);

  function openDrawer() {
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('cart-drawer-open');
    fetchCart(false);
  }
  function closeDrawer() {
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('cart-drawer-open');
  }

  // Expose globalement pour les autres sections
  window.cartDrawerOpen = openDrawer;
  window.cartDrawerFetch = function() { fetchCart(true); };

  if (openBtn)  openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay)  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDrawer(); });

  // ---- Fetch & render cart ----
  function fetchCart(openAfter) {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        updateCartUI(cart);
        if (openAfter) openDrawer();
      });
  }

  function updateCartUI(cart) {
    // Compteur header
    var countEl = qs('cartCount-' + sectionId);
    if (countEl) countEl.textContent = cart.item_count;

    // Total header
    var totalEl = qs('cartTotal-' + sectionId);
    if (totalEl) totalEl.textContent = formatMoney(cart.total_price);

    // Drawer count
    var dCount = qs('drawerCount-' + sectionId);
    if (dCount) dCount.textContent = '(' + cart.item_count + ')';

    // Drawer total
    var dTotal = qs('drawerTotal-' + sectionId);
    if (dTotal) dTotal.textContent = formatMoney(cart.total_price);

    // Drawer footer
    var footer = qs('cartDrawerFooter-' + sectionId);
    if (footer) footer.hidden = cart.item_count === 0;

    // Drawer body
    var body = qs('cartDrawerBody-' + sectionId);
    if (!body) return;

    if (cart.item_count === 0) {
      body.innerHTML = renderEmpty();
      initCountdown();
    } else {
      body.innerHTML = renderItems(cart);
      bindCartActions();
    }
  }

  function formatMoney(cents) {
    return (cents / 100).toFixed(2).replace('.', ',') + '\u00a0€';
  }

  // ---- Render panier vide ----
  function renderEmpty() {
    var fp = {{ featured_product | json }};
    var endDate = '{{ featured_end_date }}';
    var html = '<div class="cart-empty">';
    html += '<svg class="cart-empty__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="60" height="60"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>';
    html += '<p class="cart-empty__title">Votre panier est vide</p>';
    html += '<a href="/collections/all" class="cart-empty__continue">Continuer les achats</a>';

    if (fp && fp.id) {
      html += '<div class="cart-empty__featured">';
      html += '<p class="cart-empty__featured-label">Offre du moment</p>';
      if (fp.featured_image) {
        html += '<img src="' + fp.featured_image + '" alt="' + fp.title + '" class="cart-empty__featured-img">';
      }
      if (endDate) {
        html += '<div class="cart-empty__countdown flash-sale__countdown" data-end="' + endDate + '">';
        html += '<div class="flash-sale__countdown-item"><span class="flash-sale__countdown-value" data-days>00</span><span class="flash-sale__countdown-label">Jours</span></div>';
        html += '<div class="flash-sale__countdown-item"><span class="flash-sale__countdown-value" data-hours>00</span><span class="flash-sale__countdown-label">Hrs</span></div>';
        html += '<div class="flash-sale__countdown-item"><span class="flash-sale__countdown-value" data-mins>00</span><span class="flash-sale__countdown-label">Min</span></div>';
        html += '<div class="flash-sale__countdown-item"><span class="flash-sale__countdown-value" data-secs>00</span><span class="flash-sale__countdown-label">Sec</span></div>';
        html += '</div>';
      }
      html += '<p class="cart-empty__featured-title">' + fp.title + '</p>';
      html += '<p class="cart-empty__featured-price">' + formatMoney(fp.price) + '</p>';
      if (fp.variants && fp.variants[0]) {
        html += '<button class="cart-empty__add-btn" data-variant-id="' + fp.variants[0].id + '" onclick="window.customHeaderAddToCart(this)">Ajouter au panier</button>';
      }
      html += '</div>';
    }

    html += '</div>';
    return html;
  }

  // ---- Render articles ----
  function renderItems(cart) {
    var html = '<div class="cart-items">';
    cart.items.forEach(function(item) {
      html += '<div class="cart-item" data-key="' + item.key + '">';
      if (item.image) {
        html += '<img src="' + item.image + '" alt="' + item.title + '" class="cart-item__img" width="70" height="70">';
      }
      html += '<div class="cart-item__info">';
      html += '<p class="cart-item__title">' + item.product_title + '</p>';
      if (item.variant_title && item.variant_title !== 'Default Title') {
        html += '<p class="cart-item__variant">' + item.variant_title + '</p>';
      }
      html += '<p class="cart-item__price">' + formatMoney(item.final_line_price) + '</p>';
      html += '<div class="cart-item__qty">';
      html += '<button class="cart-item__qty-btn" data-action="decrease" data-key="' + item.key + '" data-qty="' + (item.quantity - 1) + '" type="button">−</button>';
      html += '<span class="cart-item__qty-val">' + item.quantity + '</span>';
      html += '<button class="cart-item__qty-btn" data-action="increase" data-key="' + item.key + '" data-qty="' + (item.quantity + 1) + '" type="button">+</button>';
      html += '</div>';
      html += '</div>';
      html += '<button class="cart-item__remove" data-key="' + item.key + '" aria-label="Supprimer" type="button">';
      html += '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">';
      html += '<polyline points="3 6 5 6 21 6"/>';
      html += '<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>';
      html += '<path d="M10 11v6M14 11v6"/>';
      html += '<path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>';
      html += '</svg></button>';
      html += '</div>';
    });
    html += '</div>';
    return html;
  }

  // ---- Actions panier (quantité / suppression) ----
  function bindCartActions() {
    var body = qs('cartDrawerBody-' + sectionId);
    if (!body) return;
    body.querySelectorAll('[data-action]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        updateLineItem(btn.dataset.key, parseInt(btn.dataset.qty));
      });
    });
    body.querySelectorAll('.cart-item__remove').forEach(function(btn) {
      btn.addEventListener('click', function() {
        updateLineItem(btn.dataset.key, 0);
      });
    });
  }

  function updateLineItem(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(r) { return r.json(); })
    .then(function(cart) { updateCartUI(cart); });
  }

  // ---- Add to cart global (utilisé par flash-sale + panier vide) ----
  window.customHeaderAddToCart = function(btn) {
    var variantId = btn.dataset.variantId;
    if (!variantId) return;
    btn.disabled = true;
    var original = btn.textContent;
    btn.textContent = 'Ajout...';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      btn.textContent = '✓ Ajouté !';
      fetchCart(true);
      setTimeout(function() {
        btn.textContent = original;
        btn.disabled = false;
      }, 2000);
    })
    .catch(function() {
      btn.textContent = 'Erreur';
      btn.disabled = false;
    });
  };

  // Rétrocompatibilité flash-sale section
  window.flashSaleAddToCart = window.customHeaderAddToCart;

  // ---- Countdown (panier vide) ----
  function pad(n) { return String(n).padStart(2, '0'); }

  function parseDate(str) {
    if (!str) return NaN;
    var parts = str.split('T');
    var datePart = parts[0];
    var timePart = parts[1] || '00:00:00';
    var ds = datePart.split('-');
    var d, m, y;
    if (ds[0].length === 4) { y = ds[0]; m = ds[1]; d = ds[2]; }
    else { d = ds[0]; m = ds[1]; y = ds[2]; }
    return new Date(y + '-' + m + '-' + d + 'T' + timePart).getTime();
  }

  function initCountdown() {
    document.querySelectorAll('#cartDrawer-' + sectionId + ' .flash-sale__countdown').forEach(function(el) {
      var endDate = parseDate(el.dataset.end);
      if (isNaN(endDate)) return;
      (function tick() {
        var diff = endDate - Date.now();
        if (diff <= 0) return;
        var d = el.querySelector('[data-days]');
        var h = el.querySelector('[data-hours]');
        var mi = el.querySelector('[data-mins]');
        var s = el.querySelector('[data-secs]');
        if (d) d.textContent = pad(Math.floor(diff / 86400000));
        if (h) h.textContent = pad(Math.floor((diff % 86400000) / 3600000));
        if (mi) mi.textContent = pad(Math.floor((diff % 3600000) / 60000));
        if (s) s.textContent = pad(Math.floor((diff % 60000) / 1000));
        setTimeout(tick, 1000);
      })();
    });
  }
  initCountdown();

  // ---- Menu mobile (hamburger drawer) ----
  (function() {
    var mobileDrawer  = document.getElementById('mobileDrawer-' + sectionId);
    var mobileOverlay = document.getElementById('mobileDrawerOverlay-' + sectionId);
    var mobileOpenBtn = document.getElementById('mobileMenuBtn-' + sectionId);
    var mobileCloseBtn = document.getElementById('mobileDrawerClose-' + sectionId);
    if (!mobileDrawer) return;

    function openMobileMenu() {
      mobileDrawer.classList.add('is-open');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cart-drawer-open');
    }
    function closeMobileMenu() {
      mobileDrawer.classList.remove('is-open');
      mobileDrawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cart-drawer-open');
    }

    if (mobileOpenBtn)  mobileOpenBtn.addEventListener('click', openMobileMenu);
    if (mobileCloseBtn) mobileCloseBtn.addEventListener('click', closeMobileMenu);
    if (mobileOverlay)  mobileOverlay.addEventListener('click', closeMobileMenu);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMobileMenu(); });

    // Sous-groupes dans le drawer mobile
    mobileDrawer.querySelectorAll('.mobile-drawer__group-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = btn.nextElementSibling;
        var isOpen = btn.classList.contains('is-open');
        btn.classList.toggle('is-open', !isOpen);
        body.style.display = isOpen ? 'none' : 'block';
      });
    });
  })();

  // ---- Menu catégories ----
  var catBtn      = qs('categoriesBtn-' + sectionId);
  var catDropdown = qs('categoriesDropdown-' + sectionId);
  if (catBtn && catDropdown) {

    function positionDropdown() {
      var btnRect = catBtn.getBoundingClientRect();
      var isMobile = window.innerWidth <= 768;
      catDropdown.style.top = (btnRect.bottom + 4) + 'px';
      if (isMobile) {
        catDropdown.style.left = '0';
        catDropdown.style.right = '0';
        catDropdown.style.width = '100%';
      } else {
        catDropdown.style.left = btnRect.left + 'px';
        catDropdown.style.right = 'auto';
        catDropdown.style.width = 'auto';
        catDropdown.style.minWidth = '220px';
      }
    }

    catBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !catDropdown.hidden;
      catDropdown.hidden = isOpen;
      catBtn.setAttribute('aria-expanded', String(!isOpen));
      if (!isOpen) positionDropdown();
    });

    document.addEventListener('click', function() {
      if (catDropdown) catDropdown.hidden = true;
      if (catBtn) catBtn.setAttribute('aria-expanded', 'false');
    });

    // Recalcule la position au scroll
    window.addEventListener('scroll', function() {
      if (!catDropdown.hidden) positionDropdown();
    }, { passive: true });
  }

  // ---- Recherche prédictive ----
  // MODIF : appel API /search/suggest.json, rendu custom gaming dark theme
  (function() {
    var searchInput = document.getElementById('customSearchInput-' + sectionId);
    var suggBox     = document.getElementById('customSearchSuggestions-' + sectionId);
    if (!searchInput || !suggBox) return;

    var debounceTimer = null;
    var selectedIdx   = -1;

    function formatPrice(str) {
      var n = parseFloat(str);
      if (isNaN(n)) return str;
      return n.toFixed(2).replace('.', ',') + ' €';
    }

    function closeSugg() {
      suggBox.hidden = true;
      searchInput.setAttribute('aria-expanded', 'false');
      selectedIdx = -1;
    }

    function openSugg() {
      if (!suggBox.querySelector('[role="option"]')) return;
      suggBox.hidden = false;
      searchInput.setAttribute('aria-expanded', 'true');
    }

    function getItems() {
      return suggBox.querySelectorAll('[role="option"]');
    }

    function setSelected(idx) {
      var items = getItems();
      items.forEach(function(item, i) {
        var sel = (i === idx);
        item.classList.toggle('is-selected', sel);
        item.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      selectedIdx = idx;
    }

    function renderSugg(data) {
      var results = data && data.resources && data.resources.results;
      if (!results) { closeSugg(); return; }

      var queries  = results.queries  || [];
      var products = results.products || [];
      if (queries.length === 0 && products.length === 0) { closeSugg(); return; }

      var html = '';

      // -- Suggestions de requête --
      if (queries.length > 0) {
        html += '<div class="custom-search-suggestions__group">';
        html += '<p class="custom-search-suggestions__title">Suggestions</p>';
        html += '<ul class="custom-search-suggestions__list">';
        queries.slice(0, 4).forEach(function(q) {
          var encodedUrl = q.url || ('/search?q=' + encodeURIComponent(q.text) + '&type=product');
          html += '<li role="option" aria-selected="false" data-url="' + encodedUrl + '" class="custom-search-suggestions__query">';
          html += '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
          html += '<span>' + (q.styled_text || q.text) + '</span>';
          html += '</li>';
        });
        html += '</ul></div>';
      }

      // -- Produits --
      if (products.length > 0) {
        html += '<div class="custom-search-suggestions__group">';
        html += '<p class="custom-search-suggestions__title">Produits</p>';
        html += '<ul class="custom-search-suggestions__list">';
        products.slice(0, 5).forEach(function(p) {
          var imgSrc = p.image ? p.image : '';
          html += '<li role="option" aria-selected="false" data-url="' + p.url + '" class="custom-search-suggestions__product">';
          if (imgSrc) {
            html += '<img src="' + imgSrc + '" alt="' + (p.title || '') + '" class="custom-search-suggestions__product-img" width="44" height="44" loading="lazy">';
          } else {
            html += '<div class="custom-search-suggestions__product-img custom-search-suggestions__product-img--placeholder"></div>';
          }
          html += '<div class="custom-search-suggestions__product-info">';
          html += '<span class="custom-search-suggestions__product-title">' + (p.title || '') + '</span>';
          if (p.price) {
            html += '<span class="custom-search-suggestions__product-price">' + formatPrice(p.price) + '</span>';
          }
          html += '</div>';
          html += '</li>';
        });
        html += '</ul>';
        html += '<a href="/search?q=' + encodeURIComponent(searchInput.value.trim()) + '&type=product" class="custom-search-suggestions__see-all">Voir tous les résultats →</a>';
        html += '</div>';
      }

      suggBox.innerHTML = html;

      // Bind clics sur chaque option
      getItems().forEach(function(item) {
        item.addEventListener('mousedown', function(e) {
          e.preventDefault();
          window.location.href = item.dataset.url;
        });
      });

      openSugg();
      selectedIdx = -1;
    }

    function fetchSugg(query) {
      if (!query || query.length < 2) { closeSugg(); return; }
      var url = '/search/suggest.json?q=' + encodeURIComponent(query)
        + '&resources[type]=product,query'
        + '&resources[limit]=5'
        + '&resources[options][unavailable_products]=last';
      fetch(url)
        .then(function(r) { return r.json(); })
        .then(renderSugg)
        .catch(closeSugg);
    }

    // Écoute saisie (debounce 300ms)
    searchInput.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      var q = searchInput.value.trim();
      debounceTimer = setTimeout(function() { fetchSugg(q); }, 300);
    });

    // Navigation clavier
    searchInput.addEventListener('keydown', function(e) {
      if (suggBox.hidden) return;
      var items = getItems();
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setSelected(selectedIdx < items.length - 1 ? selectedIdx + 1 : 0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setSelected(selectedIdx > 0 ? selectedIdx - 1 : items.length - 1);
      } else if (e.key === 'Enter' && selectedIdx >= 0 && items[selectedIdx]) {
        e.preventDefault();
        window.location.href = items[selectedIdx].dataset.url;
      } else if (e.key === 'Escape') {
        closeSugg();
      }
    });

    // Focus : rouvre si déjà des résultats
    searchInput.addEventListener('focus', function() {
      if (searchInput.value.length >= 2 && suggBox.innerHTML.trim() !== '') openSugg();
    });

    // Ferme au clic extérieur
    document.addEventListener('click', function(e) {
      if (!suggBox.contains(e.target) && e.target !== searchInput) closeSugg();
    });
  })();

  // ---- Sous-menus navigation ----
  document.querySelectorAll('#custom-header-' + sectionId + ' .custom-header__menu-link--parent').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var item = btn.closest('.custom-header__menu-item--parent');
      var isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.custom-header__menu-item--parent').forEach(function(i) { i.classList.remove('is-open'); });
      if (!isOpen) item.classList.add('is-open');
    });
  });
  document.addEventListener('click', function() {
    document.querySelectorAll('.custom-header__menu-item--parent').forEach(function(i) { i.classList.remove('is-open'); });
  });

})();
</script>

{% schema %}
{
  "name": "En-tête personnalisé",
  "tag": "header",
  "class": "custom-header-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Ligne 1 — Barre principale"
    },
    {
      "type": "color",
      "id": "top_bg",
      "label": "Couleur de fond (ligne 1)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "top_text_color",
      "label": "Couleur du texte (ligne 1)",
      "default": "#111111"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Largeur du logo",
      "default": 150
    },
    {
      "type": "color",
      "id": "search_btn_color",
      "label": "Couleur du bouton de recherche",
      "default": "#FF6600"
    },
    {
      "type": "header",
      "content": "Produit mis en avant (panier vide)"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Produit à mettre en avant"
    },
    {
      "type": "text",
      "id": "featured_end_date",
      "label": "Date de fin du compte à rebours",
      "info": "Format : DD-MM-YYYYTHH:MM:SS ex: 30-06-2025T23:59:59"
    },
    {
      "type": "header",
      "content": "Ligne 2 — Navigation"
    },
    {
      "type": "color",
      "id": "nav_bg",
      "label": "Couleur de fond (ligne 2)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_text_color",
      "label": "Couleur du texte (ligne 2)",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "nav_hover_color",
      "label": "Couleur au survol (liens nav)",
      "default": "#FF6600"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de navigation principal",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Liens secondaires (droite)"
    },
    {
      "type": "text",
