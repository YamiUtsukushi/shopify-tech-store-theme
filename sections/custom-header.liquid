<script>
// =============================================
// Fonction globale Add to Cart → ouvre le drawer
// Utilisée par : featured-products, flash-sale,
//               collection-page, cart-recommendations,
//               related-products
// =============================================
window.globalAddToCart = function(btn, variantId) {
  if (!variantId) return;
  btn.disabled = true;
  var original = btn.textContent;
  btn.textContent = 'Ajout...';

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(function(r) { return r.json(); })
  .then(function() {
    btn.textContent = '✓ Ajouté !';
    // Ouvre le drawer et rafraîchit son contenu
    if (window.cartDrawerFetch) {
      window.cartDrawerFetch();
    }
    setTimeout(function() {
      btn.textContent = original;
      btn.disabled = false;
    }, 2000);
  })
  .catch(function() {
    btn.textContent = 'Erreur';
    btn.disabled = false;
  });
};
</script>
