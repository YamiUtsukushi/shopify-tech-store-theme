{% comment %}
  Features Bar — iDhightech2
  Fichier : sections/features-bar.liquid
{% endcomment %}

{{ 'features-bar.css' | asset_url | stylesheet_tag }}

{%- assign text_color = section.settings.text_color -%}
{%- assign bg_color = section.settings.bg_color -%}

<div class="features-bar-wrapper" style="background: {{ bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="features-bar__inner">

    {%- comment %} Blocs avantages {% endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="features-bar__grid" style="--features-cols: {{ section.blocks.size }};">

        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="features-bar__item" {{ block.shopify_attributes }}>

              {%- comment %} Icône {% endcomment -%}
              <div class="features-bar__icon" style="color: {{ text_color }};">
                {%- if block.settings.custom_icon != blank -%}
                  <img
                    src="{{ block.settings.custom_icon | image_url: width: 80 }}"
                    alt="{{ block.settings.title }}"
                    class="features-bar__icon-img"
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'delivery' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'return' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.37"/></svg>
                    {%- when 'shield' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'star' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'price' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><circle cx="12" cy="12" r="10"/><path d="M14.31 8l-4.62 8M9.69 8l4.62 8M8 11h8M8 13h8"/></svg>
                    {%- when 'support' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    {%- when 'gift' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                    {%- when 'lock' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    {%- when 'heart' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    {%- when 'truck' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect x="9" y="11" width="14" height="10" rx="1"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/></svg>
                    {%- when 'smile' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                    {%- when 'tool' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="42" height="42"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>

              {%- comment %} Titre {% endcomment -%}
              {%- if block.settings.title != blank -%}
                <p class="features-bar__title" style="color: {{ text_color }};">{{ block.settings.title }}</p>
              {%- endif -%}

              {%- comment %} Description {% endcomment -%}
              {%- if block.settings.description != blank -%}
                <p class="features-bar__desc" style="color: {{ text_color | color_modify: 'alpha', 0.65 }};">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- comment %} Lien individuel {% endcomment -%}
              {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" class="features-bar__item-link" style="color: {{ section.settings.link_color }};">{{ block.settings.link_text }}</a>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    {%- endif -%}

    {%- comment %} Lien global en bas {% endcomment -%}
    {%- if section.settings.global_link_text != blank and section.settings.global_link_url != blank -%}
      <div class="features-bar__footer">
        <a href="{{ section.settings.global_link_url }}" class="features-bar__global-link" style="color: {{ section.settings.link_color }};">
          {{ section.settings.global_link_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Barre Avantages",
  "tag": "section",
  "class": "features-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Couleur des liens",
      "default": "#ec6034"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espace en haut",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espace en bas",
      "default": 40
    },
    {
      "type": "header",
      "content": "Lien global (bas de section)"
    },
    {
      "type": "text",
      "id": "global_link_text",
      "label": "Texte du lien",
      "placeholder": "Ex: Voir conditions"
    },
    {
      "type": "url",
      "id": "global_link_url",
      "label": "URL du lien"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Avantage",
      "settings": [
        {
          "type": "header",
          "content": "Icône"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône prédéfinie",
          "options": [
            { "value": "delivery", "label": "🚚 Livraison" },
            { "value": "return", "label": "↩️ Retour" },
            { "value": "shield", "label": "🛡️ Garantie" },
            { "value": "star", "label": "⭐ Étoile" },
            { "value": "price", "label": "💶 Prix" },
            { "value": "support", "label": "💬 Support" },
            { "value": "gift", "label": "🎁 Cadeau" },
            { "value": "lock", "label": "🔒 Sécurité" },
            { "value": "heart", "label": "❤️ Fidélité" },
            { "value": "truck", "label": "🚛 Transport" },
            { "value": "smile", "label": "😊 Satisfaction" },
            { "value": "tool", "label": "🔧 SAV" },
            { "value": "check", "label": "✓ Validation" }
          ],
          "default": "delivery",
          "info": "Ignoré si vous uploadez une icône personnalisée ci-dessous"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Icône personnalisée (optionnel)",
          "info": "PNG avec fond transparent recommandé. Remplace l'icône prédéfinie si uploadée."
        },
        {
          "type": "header",
          "content": "Contenu"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison offerte"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Partout en France"
        },
        {
          "type": "header",
          "content": "Lien (optionnel)"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Texte du lien"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "URL du lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre Avantages",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "delivery",
            "title": "Livraison offerte",
            "description": "Dès 50€ d'achat en France"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "return",
            "title": "Retours sous 30 jours",
            "description": "Satisfait ou remboursé"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Garantie 2 ans",
            "description": "Sur tous nos produits"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "support",
            "title": "Service après vente",
            "description": "Du lundi au vendredi 9h-18h"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "price",
            "title": "Meilleurs prix garantis",
            "description": "Nous remboursons la différence"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "lock",
            "title": "Paiement sécurisé",
            "description": "SSL 256 bits"
          }
        }
      ]
    }
  ]
}
{% endschema %}
