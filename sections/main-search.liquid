{{- 'template-collection.css' | asset_url | stylesheet_tag -}}
{{- 'component-card.css' | asset_url | stylesheet_tag -}}
{{- 'component-price.css' | asset_url | stylesheet_tag -}}
{{- 'collection-page.css' | asset_url | stylesheet_tag -}}

{%- comment %} MODIF : main-search.liquid entièrement refait pour matcher main-collection-product-grid.liquid {% endcomment -%}

{%- liquid
  assign sort_by    = search.sort_by | default: search.default_sort_by
  assign terms      = search.terms | escape
  assign res_count  = search.results_count | default: 0
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 24 %}

<div class="section-{{ section.id }}-padding">

  {%- comment %} ===== BREADCRUMB ===== {% endcomment -%}
  <div class="col-breadcrumb page-width">
    <nav class="col-breadcrumb__nav" aria-label="Breadcrumb">
      <a href="/" class="col-breadcrumb__link">Accueil</a>
      <span class="col-breadcrumb__sep">›</span>
      <a href="/collections/all" class="col-breadcrumb__link">Catalogue</a>
      <span class="col-breadcrumb__sep">›</span>
      <span class="col-breadcrumb__current">
        {%- if search.performed -%}
          Résultats pour &laquo;&nbsp;{{ search.terms }}&nbsp;&raquo;
        {%- else -%}
          Recherche
        {%- endif -%}
      </span>
    </nav>
  </div>

  {%- comment %} ===== HEADER ===== {% endcomment -%}
  <div class="col-header page-width">
    <div class="col-header__top">
      <h1 class="col-header__title">
        {%- if search.performed -%}
          Résultats de recherche
          <span class="col-header__count">({{ res_count }} résultat{% if res_count > 1 %}s{% endif %})</span>
        {%- else -%}
          Recherche
        {%- endif -%}
      </h1>
    </div>
  </div>

  {%- if search.performed -%}

    {%- if res_count == 0 -%}

      {%- comment %} ===== AUCUN RÉSULTAT ===== {% endcomment -%}
      <div class="page-width" style="text-align:center;padding:4rem 0 8rem;">
        <p style="font-size:1.1rem;margin-bottom:1.5rem;">Aucun résultat pour &laquo;&nbsp;{{ search.terms }}&nbsp;&raquo;.</p>
        <a href="/collections/all" class="col-product-card__btn" style="display:inline-block;">Voir tous les produits</a>
      </div>

    {%- else -%}

      <div class="col-layout page-width">

        {%- comment %} ===== SIDEBAR ===== {% endcomment -%}
        <aside class="col-sidebar" id="searchSidebar-{{ section.id }}">

          <div class="col-sidebar__header">
            <h2 class="col-sidebar__title">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
              </svg>
              Filtrer
            </h2>
            <button type="button" class="col-sidebar__close" onclick="searchToggleSidebar('{{ section.id }}')" aria-label="Fermer">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>

          {%- comment %} TRIER PAR {% endcomment -%}
          <div class="col-filter-group">
            <button type="button" class="col-filter-group__toggle is-open">
              <span>Trier par</span>
              <svg class="col-filter-group__caret" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="col-filter-group__body" style="display:block;">
              <select class="col-filter-select" onchange="searchSort(this)">
                {%- for option in search.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>

        </aside>

        {%- comment %} ===== CONTENU PRINCIPAL ===== {% endcomment -%}
        <div class="col-main">

          {%- comment %} Barre mobile {% endcomment -%}
          <div class="col-mobile-bar">
            <button type="button" class="col-mobile-filter-btn" onclick="searchToggleSidebar('{{ section.id }}')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
              </svg>
              Filtrer
            </button>
            <span class="col-mobile-count">{{ res_count }} résultat{% if res_count > 1 %}s{% endif %}</span>
          </div>

          <div class="col-product-list" id="SearchProductGrid-{{ section.id }}">

            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}

                {%- assign product = item -%}

                {%- assign now_s     = 'now' | date: '%s' | plus: 0 -%}
                {%- assign created_s = product.created_at | date: '%s' | plus: 0 -%}
                {%- assign diff_days = now_s | minus: created_s | divided_by: 86400 -%}
                {%- assign is_new    = false -%}
                {%- if diff_days <= 30 -%}{%- assign is_new = true -%}{%- endif -%}

                {%- assign has_discount = false -%}
                {%- assign discount_pct = 0 -%}
                {%- if product.compare_at_price > product.price -%}
                  {%- assign has_discount = true -%}
                  {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                {%- endif -%}

                <div class="col-product-card"
                  data-vendor="{{ product.vendor | escape }}"
                  data-type="{{ product.type | escape }}"
                  data-available="{{ product.available }}"
                  data-price="{{ product.price | divided_by: 100 }}"
                >

                  {%- comment %} Image + Badges {% endcomment -%}
                  <a href="{{ product.url }}" class="col-product-card__img-link">
                    <div class="col-product-card__badges">
                      {%- if is_new -%}<span class="col-badge col-badge--new">New</span>{%- endif -%}
                      {%- if has_discount -%}<span class="col-badge col-badge--discount">{{ discount_pct }}% off</span>{%- endif -%}
                    </div>
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 300 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="col-product-card__img"
                        loading="lazy"
                        width="150"
                        height="150"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'col-product-card__img col-placeholder' }}
                    {%- endif -%}
                  </a>

                  {%- comment %} Infos {% endcomment -%}
                  <div class="col-product-card__info">
                    {%- if product.vendor != blank -%}
                      <p class="col-product-card__vendor">{{ product.vendor }}</p>
                    {%- endif -%}
                    <a href="{{ product.url }}" class="col-product-card__title">{{ product.title }}</a>
                    {%- if product.description != blank -%}
                      <p class="col-product-card__desc">{{ product.description | strip_html | truncate: 120 }}</p>
                    {%- endif -%}
                    {%- if section.settings.show_stock -%}
                      {%- assign variant = product.selected_or_first_available_variant -%}
                      {%- if product.available -%}
                        {%- if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 -%}
                          <p class="col-product-card__stock">✓ En stock ({{ variant.inventory_quantity }} unités)</p>
                        {%- else -%}
                          <p class="col-product-card__stock">✓ En stock</p>
                        {%- endif -%}
                      {%- else -%}
                        <p class="col-product-card__stock col-product-card__stock--out">✗ Rupture de stock</p>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  {%- comment %} Prix + Bouton {% endcomment -%}
                  <div class="col-product-card__right">
                    <div class="col-product-card__price-wrap">
                      {%- if has_discount -%}
                        <div class="col-product-card__price-row">
                          <s class="col-product-card__compare">{{ product.compare_at_price | money }}</s>
                        </div>
                      {%- endif -%}
                      <span class="col-product-card__price">{{ product.price | money }}</span>
                    </div>
                    {%- if product.variants.size == 1 -%}
                      <button
                        type="button"
                        class="col-product-card__btn"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        onclick="collectionAddToCart(this)"
                      >
                        Ajouter au panier
                      </button>
                    {%- else -%}
                      <a href="{{ product.url }}" class="col-product-card__btn col-product-card__btn--options">
                        Voir les options
                      </a>
                    {%- endif -%}
                  </div>

                </div>

              {%- endif -%}
            {%- endfor -%}

          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}

        </div>
      </div>

      <div class="col-overlay" id="searchOverlay-{{ section.id }}" onclick="searchToggleSidebar('{{ section.id }}')"></div>

    {%- endif -%}

  {%- endif -%}

</div>

{% endpaginate %}

<script>
// MODIF : JS page search — sidebar + tri
window.searchToggleSidebar = function(id) {
  var sidebar = document.getElementById('searchSidebar-' + id);
  var overlay = document.getElementById('searchOverlay-' + id);
  if (!sidebar) return;
  var isOpen = sidebar.classList.contains('is-open');
  sidebar.classList.toggle('is-open', !isOpen);
  if (overlay) overlay.classList.toggle('is-visible', !isOpen);
  document.body.style.overflow = isOpen ? '' : 'hidden';
};

window.searchSort = function(select) {
  var url = new URL(window.location.href);
  url.searchParams.set('sort_by', select.value);
  window.location.href = url.toString();
};

// Toggle groupes sidebar
(function() {
  document.querySelectorAll('.col-filter-group__toggle').forEach(function(btn) {
    var body = btn.nextElementSibling;
    if (!body) return;
    btn.addEventListener('click', function() {
      var isOpen = btn.classList.contains('is-open');
      btn.classList.toggle('is-open', !isOpen);
      body.style.display = isOpen ? 'none' : 'block';
    });
  });
})();

// Add to cart (réutilise la fonction globale du custom-header)
window.collectionAddToCart = function(btn) {
  var variantId = btn.dataset.variantId;
  if (window.globalAddToCart) window.globalAddToCart(btn, variantId);
};
</script>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Afficher la disponibilité en stock",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
